# Adresse publique du site. La vraie valeur se définit dans Netlify, pas dans ce fichier.
NEXT_PUBLIC_SITE_URL=https://example.com

# Mot de passe de /admin. Obligatoire, mais insuffisant seul : la session visiteur doit être le compte administrateur.
ADMIN_PASSWORD=

# Signe le cookie de session. Générez une longue valeur aléatoire. Ne pas réutiliser un exemple public.
ADMIN_SESSION_SECRET=

# Optionnel. Sans ces trois variables, le formulaire prépare un mailto au lieu d'envoyer un email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Supabase. La clé publishable sert au navigateur (connexion des visiteurs).
# DATABASE_URL et SUPABASE_SECRET_KEY restent uniquement sur le serveur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Obligatoire pour envoyer des fichiers depuis l'administration. Uniquement sur le serveur.
SUPABASE_SECRET_KEY=

# Studio éditorial. Sans CRON_SECRET, la tâche quotidienne ne publie pas toute seule.
# L'administrateur peut toujours cliquer sur « Publier les contenus dus ».
CRON_SECRET=

# IA optionnelle. Sans OPENAI_API_KEY, ou avec EDITORIAL_AI_PROVIDER=off, seul l'éditeur manuel fonctionne.
# Ne jamais exposer cette clé au navigateur.
EDITORIAL_AI_PROVIDER=
OPENAI_API_KEY=
EDITORIAL_AI_MODEL=
