NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mot de passe de /admin/blog. Obligatoire. Ne pas committer la vraie valeur.
ADMIN_PASSWORD=

# Signe le cookie de session. Générez une longue valeur aléatoire. Ne pas réutiliser un exemple public.
ADMIN_SESSION_SECRET=

# Optionnel. Sans ces trois variables, le formulaire prépare un mailto au lieu d'envoyer un email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Supabase. La clé publishable peut être exposée au navigateur.
# DATABASE_URL reste uniquement sur le serveur. Ne jamais committer le mot de passe.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Obligatoire pour envoyer des fichiers depuis l'administration. Uniquement sur le serveur.
SUPABASE_SECRET_KEY=
